local function CPDP()
  for _, plr in next, game.Players:GetPlayers() do
    if plr ~= game.Players.LocalPlayer and plr == game.CreatorId or plr:IsFriendsWith(game.CreatorId) then
      return true, plr.Name
    end
  end
  return false
end

