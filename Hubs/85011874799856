local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/lolpoppyus/Roblox-Lua/master/Pop%20UI%20Lib", true))()

local Tab = library:Tab("Budgie Hub")

Tab:Button("Get super tools", function()
   local tool = Instance.new("Tool", game.Players.LocalPlayer.Backpack)
tool.Name = "A gift from heaven"
tool.RequiresHandle = false

tool.Activated:Connect(function()
  for _ = 1, 30 do task.wait() game:GetService("ReplicatedStorage"):WaitForChild("CarAirstrike"):FireServer(game.Players.LocalPlayer:GetMouse().Hit.Position) end
end)

local tool = Instance.new("Tool", game.Players.LocalPlayer.Backpack)
