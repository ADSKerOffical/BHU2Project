tool.RequiresHandle = false

tool.Activated:Connect(function()
  for _ = 1, 10 do game:GetService("ReplicatedStorage"):WaitForChild("SpawnCars"):FireServer(game.Players.LocalPlayer:GetMouse().Hit.Position) end
end)

