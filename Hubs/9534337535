local hook; hook = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
  if EnableOneShot == true and not checkcaller() and typeof(self) == "Instance" and self.ClassName == "RemoteEvent" and self.IsDescendantOf(self, game.ReplicatedStorage.Communication) then
    local args = {...}
    if #args == 3 and (typeof(args[1]) == "Instance" and args[1] == game.Players.LocalPlayer.Character.FindFirstChildOfClass(game.Players.LocalPlayer.Character, "Tool")) and typeof(args[2]) == "Instance" and args[2].IsDescendantOf(args[2], workspace.Monsters) and typeof(args[3]) == "Vector3" then
       for _ = 1, 50 do self.FireServer(self, unpack(args)) end
       rem = self
     elseif #args == 2 and (typeof(args[1]) == "Instance" and args[1] == game.Players.LocalPlayer.Character.FindFirstChildOfClass(game.Players.LocalPlayer.Character, "Tool")) and typeof(args[2]) == "Instance" and args[2].IsDescendantOf(args[2], workspace.Monsters) then
       for _ = 1, 50 do self.FireServer(self, unpack(args)) end
       rem = self
    end
  end
  return hook(self, ...)
end))

tab.newInput("Reach weapons", "Increases the hitbox of your weapons", function(text)
    for _, tool in next, game.Players.LocalPlayer.Backpack:GetChildren() do
  if tool:IsA("Tool") and tool:FindFirstChild("ReplicatedComponents") then
    for _, part in next, tool:GetDescendants() do
      if part:IsA("BasePart") then
        part.Size = Vector3.new(tonumber(text), tonumber(text), tonumber(text))
        part.CanTouch = false
        part.Massless = true
        Instance.new("SelectionBox", part).Adornee = part
      end
    end
  end
end
end)

