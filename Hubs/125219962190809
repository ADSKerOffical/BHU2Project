local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/lolpoppyus/Roblox-Lua/master/Pop%20UI%20Lib", true))()

local Tab = library:Tab("Budgie Hub")

Tab:Toggle("Loop slap all players", function(arg)
  udh = arg
   while udh and task.wait(.1) do
for _, plr in game.Players:GetPlayers() do
  if plr ~= game.Players.LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
  local args = {
   "Hollow", -- Default, Group, Gold, Hollow, Silver, Koth, Snowman
   plr.Character,
   -(game.Players.LocalPlayer.Character.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Unit
  }
   game:GetService("ReplicatedStorage").Events.Slap:FireServer(unpack(args))
  end
end
end
end)
