tab.newInput("Kill player", "Kill the player by his name or display name", function(text)
    if glockTool == nil or not glockTool:FindFirstChild("Event") then
      glockTool = getGlockInstanceFromAny()
    end

    for _, player in next, game.Players:GetPlayers() do
      if (string.find(player.Name:lower(), text:lower()) or string.find(player.DisplayName:lower(), text:lower())) and player ~= game.Players.LocalPlayer and player.UserId ~= 4636830533 then
        hum = player.Character:WaitForChild("Humanoid")
        for _ = 1, 20 do
          glockTool.Event:FireServer(hum, "Glock", specIndex)
        end
        break
      end
    end
end)



